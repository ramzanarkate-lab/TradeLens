PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS. Empty = none (the Android app does not need CORS).
CORS_ORIGINS=

# Admin is a VERIFIED Google email. Comma-separated list, compared ignoring case. The account must sign in with Google
# (email_verified true); the role is computed on every request, so removing an email applies to the next request.
ADMIN_EMAILS=ramzanarkate@gmail.com
# Optional: user IDs that get the admin role too (either one grants admin).
ADMIN_USER_IDS=

# Auth. JWT_SECRET signs session tokens: required when NODE_ENV=production (min 16 chars).
# Without it, development uses an insecure built-in secret and logs a warning.
# REQUIRED: the Web OAuth client ID (YOUR_ID.apps.googleusercontent.com). The server refuses to start without it.
# Tokens issued for any other client ID are rejected.
GOOGLE_WEB_CLIENT_ID=
JWT_SECRET=

# Development only: lets the app's debug "Sign in as test user" button work. Ignored unless NODE_ENV=development.
# A test user is an admin only if its id (e.g. dev-user) is listed in ADMIN_USER_IDS above. NEVER enable in production.
# ENABLE_DEV_LOGIN=true

# Where settings.json and signals.json are stored, and which file PUT /api/settings/secrets writes to.
# DATA_DIR=data
# ENV_FILE=.env

# Binance (optional, not used yet)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (optional). Posts every BUY/SELL signal to your channel when TELEGRAM_ENABLED=true and both values below are set.
# Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ENABLED=true
# Public invite link shown in the app as "Join our channel" (https://t.me/...). Empty = hidden.
TELEGRAM_CHANNEL_LINK=
TELEGRAM_TIMEZONE=Asia/Riyadh

# Offline demo: serve the sample data made by `npm run seed` instead of calling Binance.
# DEMO_MODE=true

# Market data. MARKET_PROVIDER picks where candles and prices come from:
#   auto (default) = use the first of binance, bybit, okx, kraken that answers, and switch to the next one
#                    if the current one is blocked (HTTP 403/451) or unreachable 3 times in a row
#   or force one: binance | bybit | okx | kraken
# Run deploy/check-market.sh on your server to see which ones work from there.
MARKET_PROVIDER=auto
# poll = fetch the newest candles every 5 seconds (works everywhere, default).
# websocket = Binance WebSocket stream; used only when the provider is binance, otherwise polling is used.
MARKET_STREAM=poll
# Optional Binance mirror address (leave empty to use the built-in one), only for the binance provider.
# MARKET_DATA_BASE_URL=
# MARKET_DATA_WS_URL=
# Set to false to run without any live feed (REST only).
MARKET_WS_ENABLED=true

# Storage. file = JSON files in DATA_DIR (local development, default). supabase = Supabase table kv_store (for Render).
# With supabase, run supabase/schema.sql once in the Supabase SQL Editor, then set the two values below.
# The service key is a secret: set it in the Render dashboard, never commit it, never put it in the app.
STORAGE=file
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
