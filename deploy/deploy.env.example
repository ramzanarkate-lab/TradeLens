# Copy this file to deploy/deploy.env and fill it in. deploy.env is git-ignored: never commit it.
# Used by deploy/preflight.sh, first-run.sh and deploy.sh on your PC.

# The Oracle VM's public IP address (Oracle console > Compute > Instances).
VM_HOST=PUBLIC_IP_OF_THE_VM

# The login user on the VM. "ubuntu" for Oracle's Ubuntu images.
VM_USER=ubuntu

# Path to the PRIVATE key file that goes with the VM (a leading ~ is fine). It must have permissions 600 or 400:
#   chmod 600 ~/.ssh/oracle_tradelens.key
SSH_KEY_PATH=~/.ssh/oracle_tradelens.key
