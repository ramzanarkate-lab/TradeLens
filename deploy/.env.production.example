# Production settings for the TradeLens server. Copy to the server as /.env (never commit the real file).
NODE_ENV=production
PORT=4000
JWT_SECRET=
GOOGLE_WEB_CLIENT_ID=
# Admin = a list of VERIFIED Google emails (comma-separated, case-insensitive). Example: ADMIN_EMAILS=ramzanarkate@gmail.com
ADMIN_EMAILS=
# Optional: user IDs that also get admin (either one grants admin).
ADMIN_USER_IDS=

# Telegram channel posting.
# The real bot token and channel ID go ONLY in the server's .env (or are saved from the app's Admin screen). Never put them in Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ENABLED=false
TELEGRAM_CHANNEL_LINK=
TELEGRAM_TIMEZONE=Asia/Riyadh

# Public name of your server (for HTTPS). A free one from duckdns.org works, e.g. tradelens.duckdns.org
DOMAIN=tradelens.example.com

# Market data provider. auto = the first of binance, bybit, okx, kraken that works from this server, and it
# switches automatically if one gets blocked. Run deploy/check-market.sh on the VM to see what works.
MARKET_PROVIDER=auto
# poll = fetch live candles every 5 seconds (works everywhere). websocket = Binance stream (Binance provider only).
MARKET_STREAM=poll
