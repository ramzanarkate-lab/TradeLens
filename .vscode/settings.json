{
  "editor.formatOnSave": true,
  // Android SDK path placeholder: set to your SDK location if ANDROID_HOME is not defined,
  // e.g. "C:\Users\<you>\AppData\Local\Android\Sdk" or "/home/<you>/Android/Sdk"
